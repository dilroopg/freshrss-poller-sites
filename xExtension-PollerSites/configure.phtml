	<?php
	// Health, computed once and shown as three separate lines. A single
	// "connected / not connected" flag hid which layer broke, and the first
	// failure a new install hits — the shared Docker network — cannot be fixed
	// by any setting on this page.
	$health = $this->health();
	$labels = [
		'http' => ['pol-ler web server', 'Is pol-ler running and reachable by name'],
		'db'   => ['pol-ler database', 'Are the credentials below correct'],
		'feed' => ['template feed', 'Does a configured template return items'],
	];
	?>
	<fieldset class="form-group">
		<legend>Is pol-ler working?</legend>
		<p class="help">Checked just now, layer by layer. Each line fails for a different reason, so fix them top to bottom.</p>
		<div class="table-wrapper">
		<table class="table">
			<thead><tr><th>Layer</th><th>State</th><th>Detail</th></tr></thead>
			<tbody>
			<?php foreach ($labels as $key => $meta) {
				$row = $health[$key] ?? ['ok' => false, 'detail' => 'not checked']; ?>
				<tr>
					<td>
						<strong><?= htmlspecialchars($meta[0], ENT_QUOTES) ?></strong><br />
						<span class="help"><?= htmlspecialchars($meta[1], ENT_QUOTES) ?></span>
					</td>
					<td>
						<?php if ($row['ok']) { ?>
							<span style="color:#3a7d44;font-weight:600">&#10003; working</span>
						<?php } else { ?>
							<span style="color:#b03030;font-weight:600">&#10007; failed</span>
						<?php } ?>
					</td>
					<td><code style="white-space:pre-wrap"><?= htmlspecialchars($row['detail'], ENT_QUOTES) ?></code></td>
				</tr>
			<?php } ?>
			</tbody>
		</table>
		</div>

		<?php if (!$health['http']['ok'] || !$health['db']['ok']) { ?>
		<div style="margin-top:1em;padding:.9em 1em;border-left:3px solid #b03030;background:rgba(176,48,48,.06)">
			<strong>pol-ler is not reachable, so the features below cannot work yet.</strong>
			<p class="help" style="margin:.5em 0 0">
				This extension does not install pol-ler for you. It is separate software with
				its own repository, and it has to share a Docker network with FreshRSS before
				either container can find the other by name. The compose file shipped in this
				extension does that wiring:
			</p>
			<pre style="margin:.6em 0;padding:.6em;background:rgba(0,0,0,.05);overflow-x:auto"><code>git clone https://github.com/aldotroiano/pol-ler
cd pol-ler
docker compose -f /path/to/xExtension-PollerSites/docker-compose.pol-ler.yml up -d

# then confirm FreshRSS can resolve it:
docker exec freshrss getent hosts pol-ler</code></pre>
			<p class="help" style="margin:.5em 0 0">
				If the last command prints nothing, the two containers are not on a shared
				network — that is the usual cause, and no field on this page will fix it.
				Full steps: <code>xExtension-PollerSites/README.md</code>.
			</p>
		</div>
		<?php } ?>
	</fieldset>

